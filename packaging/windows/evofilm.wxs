<?xml version="1.0" encoding="utf-8"?>
<!--
  EvoFilm MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build evofilm.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="EvoFilm"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="31E6FB14-9DBC-41DD-B24B-26B71FB31B62"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="EvoFilm video editor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of EvoFilm is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="EvoFilmIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="EvoFilmIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://evora.st" />
    <Property Id="ARPURLUPDATEINFO" Value="https://evora.st" />
    <Property Id="ARPHELPLINK" Value="https://evora.st" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="EvoFilm" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="EvoFilm" Level="1">
      <ComponentGroupRef Id="EvoFilmFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="EvoFilmFiles" Directory="INSTALLFOLDER">
      <Component Id="EvoFilmApp" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="EvoFilmExe" Source="$(var.BinDir)\evofilm.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="EvoFilm"
              Description="EvoFilm video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="EvoFilmIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\evofilm.exe" Value="[#EvoFilmExe]" Type="string" />
      </Component>

      <Component Id="EvoFilmCli">
        <File Id="EvoFilmCliExe" Source="$(var.BinDir)\evofilm-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
